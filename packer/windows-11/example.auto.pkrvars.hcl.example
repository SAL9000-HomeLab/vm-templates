# Copy to example.auto.pkrvars.hcl and fill in for your environment.
# Proxmox URL/API token come from PROXMOX_URL / PROXMOX_API_TOKEN_ID /
# PROXMOX_API_TOKEN_SECRET environment variables — no need to set them here.
# The build-time Administrator password has no default; export it rather
# than writing it here:  export PKR_VAR_winrm_password='...'

proxmox_node        = "pve1"
# Consumer or business media; both include "Windows 11 Pro". Setup uses the
# public Pro GVLK by default (product_key) and activates later.
iso_file            = "local:iso/Win11_24H2_English_x64.iso"
virtio_win_iso_file = "local:iso/virtio-win.iso"
vm_storage_pool     = "local-zfs"
efi_storage_pool    = "local-zfs"
network_bridge      = "vnet30"

template_id   = 9004
template_name = "tpl-win11-pro"
